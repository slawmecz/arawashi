---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Nie znaleziono strony" noindex>
  <section class="mx-auto max-w-3xl px-4 py-20 text-center">
    <p class="text-sm font-semibold tracking-[0.3em] text-brand-red uppercase">Błąd 404</p>
    <h1 class="mt-3 text-3xl font-extrabold uppercase md:text-4xl">Nie znaleziono strony</h1>
    <p class="mt-4 text-lg text-ink/80">
      Strona mogła zostać przeniesiona albo nigdy nie istniała.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-md bg-brand-red px-5 py-3 font-semibold text-white hover:bg-brand-red-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-red forced-colors:border-2"
    >
      Wróć na stronę główną
    </a>
  </section>
</BaseLayout>
