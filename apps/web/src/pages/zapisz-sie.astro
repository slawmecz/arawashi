---
/**
 * Signup page: the form island, the other ways to get in touch (phone, e-mail, Facebook,
 * Instagram, as the club's brief asks; shown when set in the CMS) and the short GDPR notice.
 */
import PageHeader from '../components/PageHeader.astro';
import SignupForm from '../components/SignupForm';
import SocialIcon from '../components/SocialIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent } from '../lib/content';

const { groups, settings } = await getSiteContent();
const telHref = settings.phone ? `tel:${settings.phone.replace(/[^\d+]/g, '')}` : undefined;
const contactLinkClass =
  'rounded font-semibold text-brand-red underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-red';
const groupNames = groups.map((group) => group.name);
const hasOtherContact = Boolean(
  settings.phone || settings.email || settings.facebookUrl || settings.instagramUrl,
);
---

<BaseLayout
  title="Zapisz się do klubu"
  description="Zapisz dziecko na treningi karate w klubie Arawashi. Pierwsze zajęcia są bezpłatne."
>
  <PageHeader
    title="Zapisz się do klubu"
    lead="Wypełnij formularz, a skontaktujemy się z Tobą, żeby umówić pierwszy, bezpłatny trening."
  />
  <div class="mx-auto max-w-6xl space-y-12 px-4 py-12 *:max-w-3xl">
    {/* Wrapper: <astro-island> uses display: contents, so it cannot carry spacing itself. */}
    <div>
      <SignupForm client:load groups={groupNames} phone={settings.phone} email={settings.email} />
    </div>
    {hasOtherContact && (
      <section
        aria-labelledby="inny-kontakt"
        class="rounded-lg border-l-4 border-brand-red bg-ink/5 p-6"
      >
        <h2 id="inny-kontakt" class="text-xl font-bold">
          Wolisz zadzwonić lub napisać?
        </h2>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-lg">
          {settings.phone && (
            <li>
              Tel.{' '}
              <a href={telHref} class={contactLinkClass}>
                {settings.phone}
              </a>
            </li>
          )}
          {settings.email && (
            <li>
              <a href={`mailto:${settings.email}`} class={`${contactLinkClass} wrap-anywhere`}>
                {settings.email}
              </a>
            </li>
          )}
          {settings.facebookUrl && (
            <li>
              <a
                href={settings.facebookUrl}
                class={`inline-flex items-center gap-2 ${contactLinkClass}`}
              >
                <SocialIcon network="facebook" />
                Facebook
              </a>
            </li>
          )}
          {settings.instagramUrl && (
            <li>
              <a
                href={settings.instagramUrl}
                class={`inline-flex items-center gap-2 ${contactLinkClass}`}
              >
                <SocialIcon network="instagram" />
                Instagram
              </a>
            </li>
          )}
        </ul>
      </section>
    )}
    <noscript>
      <p class="rounded-lg border-2 border-brand-red p-4">
        Formularz wymaga włączonej obsługi JavaScript w&nbsp;przeglądarce.
        {(settings.phone || settings.email) && (
          <>
            Możesz też skontaktować się z&nbsp;nami:{' '}
            {settings.phone && (
              <a href={telHref} class={contactLinkClass}>
                {settings.phone}
              </a>
            )}
            {settings.phone && settings.email && ' · '}
            {settings.email && (
              <a href={`mailto:${settings.email}`} class={`${contactLinkClass} wrap-anywhere`}>
                {settings.email}
              </a>
            )}
          </>
        )}
      </p>
    </noscript>

    <section
      id="informacja-rodo"
      aria-labelledby="rodo-tytul"
      class="scroll-mt-8 rounded-lg bg-ink/5 p-6"
    >
      <h2 id="rodo-tytul" class="text-xl font-bold">
        Informacja o&nbsp;przetwarzaniu danych osobowych
      </h2>
      <div class="mt-3 space-y-3 text-ink/90">
        <p>
          Administratorem danych podanych w&nbsp;formularzu jest Stowarzyszenie Sportu
          i&nbsp;Rekreacji „Arawashi”. Dane przetwarzamy wyłącznie po to, aby obsłużyć zgłoszenie
          i&nbsp;skontaktować się w&nbsp;sprawie zapisu dziecka do klubu.
        </p>
        <p>
          Zgłoszenie jest wysyłane <span class="whitespace-nowrap">e-mailem</span> bezpośrednio do
          klubu&nbsp;– strona internetowa go nie przechowuje. Przy wysyłce korzystamy z&nbsp;usług
          Cloudflare (ochrona przed spamem) i&nbsp;Brevo (wysyłka wiadomości). Podanie danych jest
          dobrowolne, ale niezbędne do rozpatrzenia zgłoszenia.
        </p>
        <p>
          Masz prawo dostępu do danych, ich sprostowania, usunięcia lub ograniczenia przetwarzania,
          prawo sprzeciwu oraz prawo wniesienia skargi do Prezesa Urzędu Ochrony Danych Osobowych.
          Szczegóły opisuje nasza
          <a
            href="/polityka-prywatnosci/"
            class="rounded font-semibold text-brand-red underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-red"
          >
            polityka prywatności.
          </a>
        </p>
      </div>
      {/* The first declaration links here; this leads back to the declarations (#oswiadczenia
          in SignupForm), which are highlighted on arrival. */}
      <p class="mt-4">
        <a
          href="#oswiadczenia"
          class="inline-block rounded py-1 font-semibold text-brand-red underline underline-offset-4 hover:text-brand-red-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-red"
        >
          ↑ Wróć do formularza
        </a>
      </p>
    </section>
  </div>
</BaseLayout>
