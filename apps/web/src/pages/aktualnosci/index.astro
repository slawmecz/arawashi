---
/** News list, newest first. */
import { Image } from 'astro:assets';
import EmptyState from '../../components/EmptyState.astro';
import PageHeader from '../../components/PageHeader.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteContent } from '../../lib/content';
import { formatDate } from '../../lib/format';

const { news, settings } = await getSiteContent();
const hasSocial = Boolean(settings.facebookUrl || settings.instagramUrl);
const socialClass =
  'inline-flex items-center gap-2 rounded py-1 font-semibold text-brand-red underline underline-offset-4 hover:text-brand-red-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-red';
---

<BaseLayout title="Aktualności" description="Aktualności z życia klubu karate Arawashi.">
  <PageHeader title="Aktualności" />
  <div class="mx-auto max-w-6xl px-4 py-12">
    {news.length > 0 ? (
      <ul class="max-w-4xl space-y-10">
        {news.map((post) => (
          <li>
            <article class="relative grid gap-6 md:grid-cols-[14rem_1fr]">
              {post.image && (
                <Image
                  src={post.image.src}
                  alt={post.image.alt}
                  width={448}
                  height={Math.round((448 * post.image.height) / post.image.width)}
                  class="aspect-[4/3] w-full rounded-lg object-cover"
                />
              )}
              <div class={post.image ? '' : 'md:col-span-2'}>
                <time datetime={post.date} class="text-sm font-semibold text-brand-red">
                  {formatDate(post.date)}
                </time>
                <h2 class="mt-1 text-2xl font-bold">
                  <a
                    href={`/aktualnosci/${post.slug}/`}
                    class="rounded underline-offset-4 after:absolute after:inset-0 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-red"
                  >
                    {post.title}
                  </a>
                </h2>
                {post.excerpt && <p class="mt-2 max-w-prose text-lg text-ink/80">{post.excerpt}</p>}
              </div>
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <div class="max-w-4xl">
        <EmptyState message="Pierwsze aktualności pojawią się wkrótce." />
        {hasSocial && (
          <p class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-lg">
            <span>Bieżące informacje znajdziesz też na naszych profilach:</span>
            {settings.facebookUrl && (
              <a href={settings.facebookUrl} class={socialClass}>
                <SocialIcon network="facebook" />
                Facebook
              </a>
            )}
            {settings.instagramUrl && (
              <a href={settings.instagramUrl} class={socialClass}>
                <SocialIcon network="instagram" />
                Instagram
              </a>
            )}
          </p>
        )}
      </div>
    )}
  </div>
</BaseLayout>
