---
/**
 * Home page: values-first hero with the two main calls to action, then training groups,
 * the next camp and the latest news. Sections without content are simply left out, so the
 * page never depends on fresh news. The hero shows the club's photo when one is set in the
 * CMS (with the rights confirmed); otherwise a dark gradient.
 */
import { getImage, Picture } from 'astro:assets';
import HeroPicture from '../components/HeroPicture.astro';
import { heroCrops } from '../lib/hero-image';
import SocialIcon from '../components/SocialIcon.astro';
import { defaultHeroPhoto, site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent } from '../lib/content';
import { formatDate, formatDateRange, upcoming } from '../lib/format';
import { nbsp } from '../lib/typography';
import { sportsOrganization, toJsonLd } from '../lib/structured-data';

const { groups, camps, news, settings } = await getSiteContent();
const siteUrl = (Astro.site ?? new URL(site.url)).href;
const logo = await getImage({ src: site.logo, width: 512, height: 512, format: 'png' });
const jsonLd = toJsonLd(sportsOrganization(settings, siteUrl, new URL(logo.src, siteUrl).href));
const today = new Date().toISOString().slice(0, 10);
const nextCamp = upcoming(camps, today)[0];
const latestNews = news.slice(0, 3);
const hasSections = groups.length > 0 || Boolean(nextCamp) || latestNews.length > 0;
// A photo whose crops cannot be built (e.g. not a Sanity URL) falls back to the gradient.
const heroImage =
  settings.heroImage && heroCrops(settings.heroImage) ? settings.heroImage : undefined;

const focusRing =
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white';
const linkClass =
  'rounded font-semibold text-brand-red underline underline-offset-4 hover:text-brand-red-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-red';
// Stretched link: the whole card is clickable, not only its title (the ::after covers the card).
const cardLink = 'after:absolute after:inset-0 after:rounded-lg';
const socialClass = `inline-flex items-center gap-2 py-1 font-semibold underline underline-offset-4 hover:text-white ${focusRing}`;

// Narrow phones (< 30rem, the two buttons stacked): the photo band starts at the top of the
// slogan (h1) and its soft start runs down through the slogan and the lead text, so the photo is
// barely visible at the top and slowly comes in towards the buttons. Its height is everything
// below that point, in rem: 8.5 (three lines of the slogan) + 1.5 (gap) + 3.5 (two lines of lead
// text) + 2.5 (gap) + 8 (two stacked buttons) + 6 (the "Śledź nas" row with its margin) + 13 (the
// text's bottom padding on phones, pb-52) = 43, or 37 without the social row. The scrim stops
// repeat these values: solid ink at the band's top, easing slowly to 72% ink at the end of the
// lead text (white text stays AA on any photo) and to 40% around the buttons (the outline button
// has its own dark fill), 72% behind "Śledź nas", then 20% towards the bottom. Every change of
// opacity follows smoothstep (generated stops), so no edge shows where a linear ramp would start
// or end.
const hasSocial = Boolean(settings.facebookUrl || settings.instagramUrl);
// Bounded ranges, so these never compete with the lg classes.
const phoneBand = hasSocial
  ? 'max-[30rem]:h-[43rem] min-[30rem]:max-lg:h-80'
  : 'max-[30rem]:h-[37rem] min-[30rem]:max-lg:h-80';
const phoneScrim = hasSocial
  ? 'max-[30rem]:bg-[linear-gradient(to_bottom,var(--color-ink)_calc(100%_-_43rem),color-mix(in_srgb,var(--color-ink)_97.9%,transparent)_calc(100%_-_40.75rem),color-mix(in_srgb,var(--color-ink)_92.7%,transparent)_calc(100%_-_38.5rem),color-mix(in_srgb,var(--color-ink)_86%,transparent)_calc(100%_-_36.25rem),color-mix(in_srgb,var(--color-ink)_79.3%,transparent)_calc(100%_-_34rem),color-mix(in_srgb,var(--color-ink)_74.1%,transparent)_calc(100%_-_31.75rem),color-mix(in_srgb,var(--color-ink)_72%,transparent)_calc(100%_-_29.5rem),color-mix(in_srgb,var(--color-ink)_69.6%,transparent)_calc(100%_-_28.583rem),color-mix(in_srgb,var(--color-ink)_63.7%,transparent)_calc(100%_-_27.667rem),color-mix(in_srgb,var(--color-ink)_56%,transparent)_calc(100%_-_26.75rem),color-mix(in_srgb,var(--color-ink)_48.3%,transparent)_calc(100%_-_25.833rem),color-mix(in_srgb,var(--color-ink)_42.4%,transparent)_calc(100%_-_24.917rem),color-mix(in_srgb,var(--color-ink)_40%,transparent)_calc(100%_-_24rem),color-mix(in_srgb,var(--color-ink)_40%,transparent)_calc(100%_-_21rem),color-mix(in_srgb,var(--color-ink)_42.4%,transparent)_calc(100%_-_20.375rem),color-mix(in_srgb,var(--color-ink)_48.3%,transparent)_calc(100%_-_19.75rem),color-mix(in_srgb,var(--color-ink)_56%,transparent)_calc(100%_-_19.125rem),color-mix(in_srgb,var(--color-ink)_63.7%,transparent)_calc(100%_-_18.5rem),color-mix(in_srgb,var(--color-ink)_69.6%,transparent)_calc(100%_-_17.875rem),color-mix(in_srgb,var(--color-ink)_72%,transparent)_calc(100%_-_17.25rem),color-mix(in_srgb,var(--color-ink)_72%,transparent)_calc(100%_-_13rem),color-mix(in_srgb,var(--color-ink)_68.1%,transparent)_calc(100%_-_12rem),color-mix(in_srgb,var(--color-ink)_58.5%,transparent)_calc(100%_-_11rem),color-mix(in_srgb,var(--color-ink)_46%,transparent)_calc(100%_-_10rem),color-mix(in_srgb,var(--color-ink)_33.5%,transparent)_calc(100%_-_9rem),color-mix(in_srgb,var(--color-ink)_23.9%,transparent)_calc(100%_-_8rem),color-mix(in_srgb,var(--color-ink)_20%,transparent)_calc(100%_-_7rem),color-mix(in_srgb,var(--color-ink)_20%,transparent))]'
  : 'max-[30rem]:bg-[linear-gradient(to_bottom,var(--color-ink)_calc(100%_-_37rem),color-mix(in_srgb,var(--color-ink)_97.9%,transparent)_calc(100%_-_34.75rem),color-mix(in_srgb,var(--color-ink)_92.7%,transparent)_calc(100%_-_32.5rem),color-mix(in_srgb,var(--color-ink)_86%,transparent)_calc(100%_-_30.25rem),color-mix(in_srgb,var(--color-ink)_79.3%,transparent)_calc(100%_-_28rem),color-mix(in_srgb,var(--color-ink)_74.1%,transparent)_calc(100%_-_25.75rem),color-mix(in_srgb,var(--color-ink)_72%,transparent)_calc(100%_-_23.5rem),color-mix(in_srgb,var(--color-ink)_69.6%,transparent)_calc(100%_-_22.583rem),color-mix(in_srgb,var(--color-ink)_63.7%,transparent)_calc(100%_-_21.667rem),color-mix(in_srgb,var(--color-ink)_56%,transparent)_calc(100%_-_20.75rem),color-mix(in_srgb,var(--color-ink)_48.3%,transparent)_calc(100%_-_19.833rem),color-mix(in_srgb,var(--color-ink)_42.4%,transparent)_calc(100%_-_18.917rem),color-mix(in_srgb,var(--color-ink)_40%,transparent)_calc(100%_-_18rem),color-mix(in_srgb,var(--color-ink)_40%,transparent)_calc(100%_-_13rem),color-mix(in_srgb,var(--color-ink)_38.5%,transparent)_calc(100%_-_12rem),color-mix(in_srgb,var(--color-ink)_34.8%,transparent)_calc(100%_-_11rem),color-mix(in_srgb,var(--color-ink)_30%,transparent)_calc(100%_-_10rem),color-mix(in_srgb,var(--color-ink)_25.2%,transparent)_calc(100%_-_9rem),color-mix(in_srgb,var(--color-ink)_21.5%,transparent)_calc(100%_-_8rem),color-mix(in_srgb,var(--color-ink)_20%,transparent)_calc(100%_-_7rem),color-mix(in_srgb,var(--color-ink)_20%,transparent))]';
// The 3:2 photo fills the band's height there, so it is drawn 1.5 × the band height wide.
const phonePhotoWidth = hasSocial ? '64.5rem' : '55.5rem';
---

<BaseLayout mainClass="flex flex-col">
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  {/* grow: on a short page (empty CMS) the hero fills the space above the footer.
      Narrow phones (< 30rem): the photo band starts at the top of the slogan (see phoneBand).
      Wider phones and tablets: the text sits on solid ink and the photo is a 20rem band below
      it. From lg: text on the left, photo on the right. The 20rem band height (h-80) is
      repeated in the scrim stops, the calligraphy offset and the text's bottom padding
      (pb-76 = 19rem: the band overlaps the last 1rem). Narrow phones use pb-52. */}
  <section class="relative isolate flex grow flex-col justify-center overflow-hidden bg-ink text-white">
    {/* The club's own photo from the CMS, otherwise the default photo (config/site.ts). */}
    {heroImage ? (
      <HeroPicture
        image={heroImage}
        class={`absolute inset-x-0 bottom-0 -z-30 w-full object-cover forced-colors:hidden lg:top-0 lg:h-full ${phoneBand}`}
      />
    ) : (
      <Picture
        src={defaultHeroPhoto.src}
        alt=""
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600, 2400]}
        sizes={`(max-width: 29.99rem) ${phonePhotoWidth}, (max-width: 63.99rem) 100vw, 90vw`}
        loading="eager"
        fetchpriority="high"
        class={`absolute right-0 bottom-0 -z-30 w-full object-cover object-[50%_58%] forced-colors:hidden lg:top-0 lg:h-full lg:w-[60%] lg:object-[50%_55%] ${phoneBand}`}
      />
    )}
    {/* Scrim keeping WCAG AA text contrast on any photo. Narrow phones: see phoneScrim. Wider
        phones and tablets: solid ink behind the text, fading into the photo band. From lg: a
        left-to-right gradient (text on the left, photo visible on the right, as in the club's
        mockup). */}
    <div
      aria-hidden="true"
      class={`absolute inset-0 -z-20 min-[30rem]:max-lg:bg-[linear-gradient(to_bottom,var(--color-ink)_calc(100%_-_20rem),color-mix(in_srgb,var(--color-ink)_45%,transparent)_calc(100%_-_14rem),color-mix(in_srgb,var(--color-ink)_20%,transparent))] lg:bg-[linear-gradient(to_right,var(--color-ink)_45%,color-mix(in_srgb,var(--color-ink)_30%,transparent)_95%)] ${phoneScrim}`}
    />
    {/* Phones and tablets: a soft shade in the bottom-right corner of the photo band (below the
        text), so the calligraphy and its reading stay visible on a light photo. Narrow phones: as
        tall as the shorter part below the text, and stronger (the smoke at the photo's bottom is
        light). */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute right-0 bottom-0 -z-15 w-44 forced-colors:hidden max-[30rem]:h-52 max-[30rem]:bg-[linear-gradient(to_left,color-mix(in_srgb,var(--color-ink)_80%,transparent),color-mix(in_srgb,var(--color-ink)_45%,transparent)_60%,transparent)] max-[30rem]:[mask-image:linear-gradient(to_bottom,transparent,black_3rem)] min-[30rem]:h-76 min-[30rem]:bg-[linear-gradient(to_left,color-mix(in_srgb,var(--color-ink)_70%,transparent),color-mix(in_srgb,var(--color-ink)_35%,transparent)_60%,transparent)] min-[30rem]:[mask-image:linear-gradient(to_bottom,transparent,black_5rem)] lg:hidden"
    />
    {/* Decorative calligraphy: 空手道 (karate-dō, "the way of the empty hand"), with its reading
        in Latin letters on the left of it. Phones and tablets: on the right of the photo band,
        below the text; on narrow phones smaller and 1rem above the band's bottom. From lg:
        large and faint at the left edge; the reading shows from xl only, where it fits in the
        margin left of the hero text instead of running behind it. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute right-4 -z-10 max-[30rem]:top-[calc(100%_-_11.5rem)] min-[30rem]:max-lg:top-[calc(100%_-_17.5rem)] flex items-center gap-3 select-none forced-colors:hidden md:right-6 lg:top-1/2 lg:right-auto lg:left-6 lg:-translate-y-1/2"
    >
      <p class="text-lg font-semibold tracking-[0.4em] whitespace-nowrap text-white/50 [writing-mode:vertical-rl] lg:max-xl:hidden">
        KARATE-DŌ
      </p>
      <p
        lang="ja"
        class="leading-none font-bold whitespace-nowrap text-white/50 max-[30rem]:text-[3.5rem] min-[30rem]:max-lg:text-[4rem] [text-shadow:0_2px_14px_rgb(0_0_0/0.7)] [writing-mode:vertical-rl] lg:text-[12rem] lg:text-white/5 lg:[text-shadow:none]"
      >
        空手道
      </p>
    </div>

    <div class="mx-auto w-full max-w-6xl px-4 pt-12 max-[30rem]:pb-52 min-[30rem]:max-lg:pb-76 md:pt-36 lg:pb-36">
      {/* Flex with a gap, so source formatting cannot change the spacing: one line with "·"
          from sm, two deliberate lines (no dangling separator) on phones. */}
      <p
        class:list={[
          'flex flex-wrap gap-x-[0.6em] text-sm font-semibold tracking-[0.3em] uppercase',
          // Over a photo on phones and tablets, white text keeps the contrast; red from lg.
          'text-white/80 lg:text-brand-red-bright',
        ]}
      >
        <span class="whitespace-nowrap max-sm:basis-full">Klub karate WKF</span>
        <span aria-hidden="true" class="max-sm:hidden">
          ·
        </span>
        <span class="whitespace-nowrap">Gmina Siechnice</span>
      </p>
      <h1 class="mt-4 max-w-3xl text-4xl leading-tight font-extrabold uppercase md:text-6xl">
        Szacunek, dyscyplina, charakter
      </h1>
      <p class="mt-6 max-w-xl text-lg text-white/85 md:text-xl">
        – wartości, na których szkolimy przyszłych{' '}
        <strong class="text-white uppercase">mistrzów</strong>.
      </p>
      {/* Narrow phones: always stacked (the photo band's height counts on two rows), and the
          outline button gets a dark fill because it sits on the photo there. */}
      <div class="mt-10 flex flex-wrap gap-4 max-[30rem]:flex-col max-[30rem]:items-start">
        <a
          href="/zapisz-sie/"
          class={`rounded-md border-2 border-brand-red bg-brand-red px-6 py-3 text-lg font-semibold hover:border-brand-red-dark hover:bg-brand-red-dark ${focusRing}`}
        >
          Zapisz się do klubu
        </a>
        <a
          href="/klub/"
          class={`rounded-md border-2 border-white px-6 py-3 text-lg font-semibold hover:bg-white hover:text-ink max-[30rem]:bg-ink/80 ${focusRing}`}
        >
          Poznaj Arawashi
        </a>
      </div>
      {(settings.facebookUrl || settings.instagramUrl) && (
        <p class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-white/85">
          <span class="w-full sm:w-auto">Śledź nas:</span>
          {settings.facebookUrl && (
            <a href={settings.facebookUrl} class={socialClass}>
              <SocialIcon network="facebook" />
              Facebook
            </a>
          )}
          {settings.instagramUrl && (
            <a href={settings.instagramUrl} class={socialClass}>
              <SocialIcon network="instagram" />
              Instagram
            </a>
          )}
        </p>
      )}
    </div>
  </section>

  {hasSections && (
    <div class="mx-auto w-full max-w-6xl space-y-16 px-4 py-16">
      {groups.length > 0 && (
        <section aria-labelledby="home-grupy">
          <h2 id="home-grupy" class="text-3xl font-extrabold uppercase">
            Treningi dla każdego
          </h2>
          <ul class="mt-6 grid gap-6 md:grid-cols-3">
            {groups.map((group) => (
              <li class="rounded-lg border border-ink/15 p-6">
                <h3 class="text-xl font-bold">{nbsp(group.name)}</h3>
                {group.ageRange && (
                  <p class="mt-1 font-semibold text-brand-red">{group.ageRange}</p>
                )}
                {/* E.g. that the preschool group trains in the kindergarten, not at the hall. */}
                {group.description && <p class="mt-3 text-ink/80">{nbsp(group.description)}</p>}
              </li>
            ))}
          </ul>
          <p class="mt-6 text-lg">
            Pierwszy trening jest bezpłatny.{' '}
            <a href="/treningi/" class={linkClass}>
              Zobacz grafik zajęć
            </a>
          </p>
        </section>
      )}

      {nextCamp && (
        <section
          aria-labelledby="home-oboz"
          class="relative rounded-lg bg-brand-blue p-8 text-white hover:bg-brand-blue/90"
        >
          <h2 id="home-oboz" class="text-sm font-semibold tracking-widest uppercase">
            {nextCamp.kind === 'polkolonie' ? 'Najbliższe półkolonie' : 'Najbliższy obóz'}
          </h2>
          <p class="mt-2 text-2xl font-bold">{nextCamp.title}</p>
          <p class="mt-1 text-lg">{formatDateRange(nextCamp.startDate, nextCamp.endDate)}</p>
          <a
            href="/obozy/"
            class={`mt-4 inline-block font-semibold underline underline-offset-4 ${cardLink} ${focusRing}`}
          >
            Szczegóły
          </a>
        </section>
      )}

      {latestNews.length > 0 && (
        <section aria-labelledby="home-aktualnosci">
          <h2 id="home-aktualnosci" class="text-3xl font-extrabold uppercase">
            Aktualności
          </h2>
          <ul class="mt-6 grid gap-6 md:grid-cols-3">
            {latestNews.map((post) => (
              <li class="relative rounded-lg border border-ink/15 p-6 hover:border-brand-red">
                <time datetime={post.date} class="text-sm font-semibold text-brand-red">
                  {formatDate(post.date)}
                </time>
                <h3 class="mt-1 text-lg font-bold">
                  <a
                    href={`/aktualnosci/${post.slug}/`}
                    class={`rounded underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-red ${cardLink}`}
                  >
                    {post.title}
                  </a>
                </h3>
              </li>
            ))}
          </ul>
          <p class="mt-6">
            <a href="/aktualnosci/" class={linkClass}>
              Wszystkie aktualności
            </a>
          </p>
        </section>
      )}
    </div>
  )}
</BaseLayout>
