---
/**
 * Home page: values-first hero with the two main calls to action, then training groups,
 * the next camp and the latest news. Sections without content are simply left out, so the
 * page never depends on fresh news. The hero shows the club's photo when one is set in the
 * CMS (with the rights confirmed); otherwise a dark gradient.
 */
import { getImage, Picture } from 'astro:assets';
import HeroPicture from '../components/HeroPicture.astro';
import { heroCrops } from '../lib/hero-image';
import SocialIcon from '../components/SocialIcon.astro';
import { defaultHeroPhoto, site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent } from '../lib/content';
import { formatDate, formatDateRange, upcoming } from '../lib/format';
import { nbsp } from '../lib/typography';
import { sportsOrganization, toJsonLd } from '../lib/structured-data';

const { groups, camps, news, settings } = await getSiteContent();
const siteUrl = (Astro.site ?? new URL(site.url)).href;
const logo = await getImage({ src: site.logo, width: 512, height: 512, format: 'png' });
const jsonLd = toJsonLd(sportsOrganization(settings, siteUrl, new URL(logo.src, siteUrl).href));
const today = new Date().toISOString().slice(0, 10);
const nextCamp = upcoming(camps, today)[0];
const latestNews = news.slice(0, 3);
const hasSections = groups.length > 0 || Boolean(nextCamp) || latestNews.length > 0;
// A photo whose crops cannot be built (e.g. not a Sanity URL) falls back to the gradient.
const heroImage =
  settings.heroImage && heroCrops(settings.heroImage) ? settings.heroImage : undefined;

const focusRing =
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white';
const linkClass =
  'rounded font-semibold text-brand-red underline underline-offset-4 hover:text-brand-red-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-red';
// Stretched link: the whole card is clickable, not only its title (the ::after covers the card).
const cardLink = 'after:absolute after:inset-0 after:rounded-lg';
const socialClass = `inline-flex items-center gap-2 py-1 font-semibold underline underline-offset-4 hover:text-white ${focusRing}`;
---

<BaseLayout mainClass="flex flex-col">
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  {/* grow: on a short page (empty CMS) the hero fills the space above the footer. */}
  <section class="relative isolate flex grow flex-col justify-center overflow-hidden bg-ink text-white">
    {/* The club's own photo from the CMS, otherwise the default photo (config/site.ts). */}
    {heroImage ? (
      <HeroPicture
        image={heroImage}
        class="absolute inset-0 -z-30 size-full object-cover forced-colors:hidden"
      />
    ) : (
      <Picture
        src={defaultHeroPhoto.src}
        alt=""
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600, 2400]}
        sizes="(max-width: 47.99rem) 280vw, (max-width: 63.99rem) 150vw, 90vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-y-0 right-0 -z-30 h-full w-full object-cover object-[50%_55%] forced-colors:hidden lg:w-[60%]"
      />
    )}
    {/* Scrim keeping WCAG AA text contrast on any photo: a flat 70 % layer on phones and
        tablets (text spans the width), a left-to-right gradient from lg (text on the left,
        photo visible on the right, as in the club's mockup). Measured: shots/hero-contrast. */}
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-20 max-lg:bg-ink/70 lg:bg-[linear-gradient(to_right,var(--color-ink)_45%,color-mix(in_srgb,var(--color-ink)_30%,transparent)_95%)]"
    />
    {/* Decorative calligraphy: 空手道 (karate-dō, "the way of the empty hand"), inset from the
        edge. Its reading in Latin letters shows from xl only, where it fits in the margin left
        of the hero text instead of running behind it. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-1/2 left-4 -z-10 flex -translate-y-1/2 items-center gap-3 select-none forced-colors:hidden md:left-6"
    >
      <p class="text-lg font-semibold tracking-[0.4em] whitespace-nowrap text-white/50 [writing-mode:vertical-rl] max-xl:hidden">
        KARATE-DŌ
      </p>
      <p
        lang="ja"
        class="text-[9rem] leading-none font-bold whitespace-nowrap text-white/5 [writing-mode:vertical-rl] md:text-[12rem]"
      >
        空手道
      </p>
    </div>

    <div class="mx-auto w-full max-w-6xl px-4 py-24 md:py-36">
      {/* Flex with a gap, so source formatting cannot change the spacing: one line with "·"
          from sm, two deliberate lines (no dangling separator) on phones. */}
      <p
        class:list={[
          'flex flex-wrap gap-x-[0.6em] text-sm font-semibold tracking-[0.3em] uppercase',
          // Over a photo on phones and tablets, white text keeps the contrast; red from lg.
          'text-white/80 lg:text-brand-red-bright',
        ]}
      >
        <span class="whitespace-nowrap max-sm:basis-full">Klub karate WKF</span>
        <span aria-hidden="true" class="max-sm:hidden">
          ·
        </span>
        <span class="whitespace-nowrap">Gmina Siechnice</span>
      </p>
      <h1 class="mt-4 max-w-3xl text-4xl leading-tight font-extrabold uppercase md:text-6xl">
        Szacunek, dyscyplina, charakter
      </h1>
      <p class="mt-6 max-w-xl text-lg text-white/85 md:text-xl">
        – wartości, na których szkolimy przyszłych{' '}
        <strong class="text-white uppercase">mistrzów</strong>.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/zapisz-sie/"
          class={`rounded-md border-2 border-brand-red bg-brand-red px-6 py-3 text-lg font-semibold hover:border-brand-red-dark hover:bg-brand-red-dark ${focusRing}`}
        >
          Zapisz się do klubu
        </a>
        <a
          href="/klub/"
          class={`rounded-md border-2 border-white px-6 py-3 text-lg font-semibold hover:bg-white hover:text-ink ${focusRing}`}
        >
          Poznaj Arawashi
        </a>
      </div>
      {(settings.facebookUrl || settings.instagramUrl) && (
        <p class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-white/85">
          <span class="w-full sm:w-auto">Śledź nas:</span>
          {settings.facebookUrl && (
            <a href={settings.facebookUrl} class={socialClass}>
              <SocialIcon network="facebook" />
              Facebook
            </a>
          )}
          {settings.instagramUrl && (
            <a href={settings.instagramUrl} class={socialClass}>
              <SocialIcon network="instagram" />
              Instagram
            </a>
          )}
        </p>
      )}
    </div>
  </section>

  {hasSections && (
    <div class="mx-auto w-full max-w-6xl space-y-16 px-4 py-16">
      {groups.length > 0 && (
        <section aria-labelledby="home-grupy">
          <h2 id="home-grupy" class="text-3xl font-extrabold uppercase">
            Treningi dla każdego
          </h2>
          <ul class="mt-6 grid gap-6 md:grid-cols-3">
            {groups.map((group) => (
              <li class="rounded-lg border border-ink/15 p-6">
                <h3 class="text-xl font-bold">{nbsp(group.name)}</h3>
                {group.ageRange && (
                  <p class="mt-1 font-semibold text-brand-red">{group.ageRange}</p>
                )}
              </li>
            ))}
          </ul>
          <p class="mt-6 text-lg">
            Pierwszy trening jest bezpłatny.{' '}
            <a href="/treningi/" class={linkClass}>
              Zobacz grafik zajęć
            </a>
          </p>
        </section>
      )}

      {nextCamp && (
        <section
          aria-labelledby="home-oboz"
          class="relative rounded-lg bg-brand-blue p-8 text-white hover:bg-brand-blue/90"
        >
          <h2 id="home-oboz" class="text-sm font-semibold tracking-widest uppercase">
            {nextCamp.kind === 'polkolonie' ? 'Najbliższe półkolonie' : 'Najbliższy obóz'}
          </h2>
          <p class="mt-2 text-2xl font-bold">{nextCamp.title}</p>
          <p class="mt-1 text-lg">{formatDateRange(nextCamp.startDate, nextCamp.endDate)}</p>
          <a
            href="/obozy/"
            class={`mt-4 inline-block font-semibold underline underline-offset-4 ${cardLink} ${focusRing}`}
          >
            Szczegóły
          </a>
        </section>
      )}

      {latestNews.length > 0 && (
        <section aria-labelledby="home-aktualnosci">
          <h2 id="home-aktualnosci" class="text-3xl font-extrabold uppercase">
            Aktualności
          </h2>
          <ul class="mt-6 grid gap-6 md:grid-cols-3">
            {latestNews.map((post) => (
              <li class="relative rounded-lg border border-ink/15 p-6 hover:border-brand-red">
                <time datetime={post.date} class="text-sm font-semibold text-brand-red">
                  {formatDate(post.date)}
                </time>
                <h3 class="mt-1 text-lg font-bold">
                  <a
                    href={`/aktualnosci/${post.slug}/`}
                    class={`rounded underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-red ${cardLink}`}
                  >
                    {post.title}
                  </a>
                </h3>
              </li>
            ))}
          </ul>
          <p class="mt-6">
            <a href="/aktualnosci/" class={linkClass}>
              Wszystkie aktualności
            </a>
          </p>
        </section>
      )}
    </div>
  )}
</BaseLayout>
