---
/** Training: groups, weekly schedule (with a group filter) and how to start. */
import EmptyState from '../components/EmptyState.astro';
import PageHeader from '../components/PageHeader.astro';
import ScheduleFilter, { type ScheduleRow } from '../components/ScheduleFilter';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent } from '../lib/content';
import { weekdayName } from '../lib/format';
import { nbsp } from '../lib/typography';

const { groups, schedule, settings } = await getSiteContent();
const rows: ScheduleRow[] = schedule.map((slot) => ({
  id: slot.id,
  groupName: slot.groupName,
  dayName: weekdayName(slot.day),
  start: slot.start,
  end: slot.end,
  venue: slot.venue,
}));
const scheduleGroups = [...new Set(schedule.map((slot) => slot.groupName))];
const telHref = settings.phone ? `tel:${settings.phone.replace(/[^\d+]/g, '')}` : undefined;
---

<BaseLayout
  title="Treningi"
  description="Grafik zajęć, grupy wiekowe i pierwsze bezpłatne zajęcia w klubie karate Arawashi."
>
  <PageHeader
    title="Treningi"
    lead="Zajęcia karate dla dzieci i młodzieży. Pierwszy trening jest bezpłatny."
  />

  <div class="mx-auto max-w-6xl space-y-16 px-4 py-12">
    <section aria-labelledby="grafik">
      <h2 id="grafik" class="mb-6 text-2xl font-bold">
        Grafik zajęć
      </h2>
      {rows.length > 0 ? (
        <ScheduleFilter client:visible rows={rows} groups={scheduleGroups} />
      ) : (
        <EmptyState message="Grafik zajęć na ten sezon pojawi się wkrótce." />
      )}
    </section>

    <section aria-labelledby="grupy">
      <h2 id="grupy" class="mb-6 text-2xl font-bold">
        Grupy
      </h2>
      {groups.length > 0 ? (
        <ul class="grid gap-6 md:grid-cols-2">
          {groups.map((group) => (
            <li class="rounded-lg border border-ink/15 p-6">
              <h3 class="text-xl font-bold">{nbsp(group.name)}</h3>
              {group.ageRange && <p class="mt-1 font-semibold text-brand-red">{group.ageRange}</p>}
              {group.description && <p class="mt-3 text-ink/80">{group.description}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState message="Opis grup treningowych pojawi się wkrótce." showContact={false} />
      )}
    </section>

    <section aria-labelledby="pierwszy-trening" class="rounded-lg bg-ink p-8 text-white">
      <h2 id="pierwszy-trening" class="text-2xl font-bold">
        Pierwszy trening za&nbsp;darmo
      </h2>
      <ol class="mt-4 list-decimal space-y-2 pl-6 text-lg text-white/90">
        <li>
          {telHref ? (
            <>
              Wypełnij formularz zgłoszeniowy albo zadzwoń:{' '}
              <a
                href={telHref}
                class="font-semibold whitespace-nowrap underline underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
              >
                {settings.phone}
              </a>
            </>
          ) : (
            'Wypełnij formularz zgłoszeniowy.'
          )}
        </li>
        <li>Odezwiemy się i&nbsp;pomożemy wybrać grupę oraz termin.</li>
        <li>Przyjdź na zajęcia w&nbsp;wygodnym stroju sportowym i&nbsp;z&nbsp;butelką wody.</li>
      </ol>
      <a
        href="/zapisz-sie/"
        class="mt-6 inline-block rounded-md bg-brand-red px-6 py-3 font-semibold hover:bg-brand-red-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white forced-colors:border-2"
      >
        Zapisz się do klubu
      </a>
    </section>
  </div>
</BaseLayout>
