---
/** Frequently asked questions, as native <details> disclosures (no JavaScript needed). */
import EmptyState from '../../components/EmptyState.astro';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteContent } from '../../lib/content';

const { faq } = await getSiteContent();
---

<BaseLayout
  title="Pytania i odpowiedzi"
  description="Najczęstsze pytania o treningi w klubie Arawashi."
>
  <PageHeader title="Pytania i odpowiedzi" back={{ href: '/klub/', label: 'Poznaj Arawashi' }} />
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="max-w-2xl">
      {faq.length > 0 ? (
        <div class="space-y-4">
          {faq.map((item) => (
            <details class="group rounded-lg border border-ink/15">
              <summary class="cursor-pointer rounded-lg p-5 text-lg font-bold marker:text-brand-red hover:bg-ink/5 hover:text-brand-red focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red">
                {item.question}
              </summary>
              <div class="prose-club max-w-none px-5 pb-5 text-base" set:html={item.answerHtml} />
            </details>
          ))}
        </div>
      ) : (
        <EmptyState message="Odpowiedzi na najczęstsze pytania pojawią się wkrótce." />
      )}
    </div>
  </div>
</BaseLayout>
