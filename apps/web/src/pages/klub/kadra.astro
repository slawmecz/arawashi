---
/**
 * Coaching staff: photo (only with consent), rank and a short bio. Two columns only from lg:
 * on tablets a photo next to the bio would leave the text a very narrow column.
 */
import { Image } from 'astro:assets';
import EmptyState from '../../components/EmptyState.astro';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteContent } from '../../lib/content';

const { coaches } = await getSiteContent();
---

<BaseLayout title="Kadra trenerska" description="Trenerzy klubu karate Arawashi.">
  <PageHeader title="Kadra trenerska" back={{ href: '/klub/', label: 'Poznaj Arawashi' }} />
  <div class="mx-auto max-w-6xl px-4 py-12">
    {coaches.length > 0 ? (
      <ul class="grid gap-8 lg:grid-cols-2">
        {coaches.map((coach) => (
          <li class="flex flex-col gap-4 rounded-lg border border-ink/15 p-6 sm:flex-row">
            {coach.photo && (
              <Image
                src={coach.photo.src}
                alt={coach.photo.alt}
                width={320}
                height={320}
                fit="cover"
                class="size-40 shrink-0 rounded-lg object-cover"
              />
            )}
            <div>
              <h2 class="text-xl font-bold">{coach.name}</h2>
              {(coach.role || coach.rank) && (
                <p class="mt-1 font-semibold text-brand-red">
                  {[coach.role, coach.rank].filter(Boolean).join(' · ')}
                </p>
              )}
              {coach.bioHtml && <div class="prose-club mt-3 text-base" set:html={coach.bioHtml} />}
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <EmptyState message="Przedstawimy naszą kadrę trenerską wkrótce." />
    )}
  </div>
</BaseLayout>
