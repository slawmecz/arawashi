---
/**
 * Base layout for every page: <head> metadata, skip link, header and footer.
 * Pages pass their own title and description; unfinished pages pass `noindex`.
 */
import { SITE_STAGE } from 'astro:env/server';
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Keeps unfinished pages out of search engines. */
  noindex?: boolean;
  /** Extra classes for <main>, e.g. a flex column so the home hero can fill a short page. */
  mainClass?: string;
}

const { title, description = site.description, noindex = false, mainClass } = Astro.props;
// The public test copy (SITE_STAGE=test) is kept out of search engines on every page.
const isTest = SITE_STAGE === 'test';
const robots = isTest ? 'noindex, nofollow' : noindex ? 'noindex' : undefined;
const pageTitle = title
  ? `${title} | ${site.name}`
  : `${site.name} — klub karate WKF w gminie Siechnice`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
// Preview image for social media (generated by scripts/generate-brand-images.mjs).
const ogImageUrl = new URL('/og-default.png', Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!isTest && <link rel="sitemap" href="/sitemap-index.xml" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#0b0b0d" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex min-h-dvh flex-col bg-paper font-sans text-ink antialiased">
    <a
      href="#tresc"
      class="sr-only z-50 rounded bg-brand-red px-4 py-2 font-semibold text-white focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:px-4 focus:py-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
    >
      Przejdź do treści
    </a>
    {isTest && (
      <p class="bg-brand-blue px-4 py-2 text-center text-sm font-semibold text-white">
        Wersja testowa strony klubu&nbsp;— treści są jeszcze uzupełniane.
      </p>
    )}
    <SiteHeader />
    {/* wrap-anywhere: a long word (e.g. in a CMS title) wraps, even inside grid items, instead of widening the page. */}
    <main id="tresc" class:list={['flex-1 wrap-anywhere', mainClass]}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
