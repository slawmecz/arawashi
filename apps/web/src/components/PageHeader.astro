---
/**
 * Dark page header band with the page title, an optional lead paragraph and an optional link
 * back to the parent section (e.g. club sub-pages → "Poznaj Arawashi").
 * The faint blue glow repeats the home hero, so every page carries the club's blue.
 */
import { nbsp } from '../lib/typography';

interface Props {
  title: string;
  lead?: string;
  back?: { href: string; label: string };
}

const { title, lead, back } = Astro.props;
---

<header class="relative isolate overflow-hidden bg-ink text-white">
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,var(--color-brand-blue)_0%,transparent_55%)] opacity-40"
  ></div>
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    {back && (
      <a
        href={back.href}
        class="mb-4 inline-block rounded font-semibold text-white/85 underline underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      >
        ← {back.label}
      </a>
    )}
    <h1 class="text-3xl font-extrabold uppercase md:text-5xl">{nbsp(title)}</h1>
    {lead && <p class="mt-4 max-w-2xl text-lg text-white/85">{nbsp(lead)}</p>}
  </div>
</header>
