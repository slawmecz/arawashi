---
/**
 * Facebook / Instagram glyph, shown next to the visible link text (decorative, aria-hidden).
 * Facebook path: Simple Icons 16.37.0 (CC0-1.0). Instagram: the usual outline glyph drawn with
 * three basic shapes (a few hundred bytes instead of a 2 KB path). The logos are trademarks of
 * their owners and are used only to link to the club's own profiles.
 */
interface Props {
  network: 'facebook' | 'instagram';
  class?: string;
}

const { network, class: className = 'size-5' } = Astro.props;

const FACEBOOK =
  'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z';
---

{network === 'facebook' ? (
  <svg
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 24 24"
    fill="currentColor"
    class={className}
  >
    <path d={FACEBOOK} />
  </svg>
) : (
  <svg
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    class={className}
  >
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none" />
  </svg>
)}
