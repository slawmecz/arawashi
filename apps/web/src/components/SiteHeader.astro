---
/**
 * Site header: club logo, main menu and the signup call to action.
 * The full menu needs about 780 px, so it is shown from lg (1024 px); below that a native
 * <details> disclosure works without JavaScript, and a small script only adds the expected
 * extras (close on Escape, outside tap, focus leaving, back/forward cache). From sm the
 * signup button stays visible next to "Menu". The row may wrap when text is enlarged, so
 * nothing overlaps.
 *
 * The header sticks to the top of the screen. While the visitor scrolls down it slides away,
 * and it slides back as soon as they scroll up: the standard "hide on scroll" top bar (Material's
 * enterAlways behaviour, Headroom.js). At the top of the page it looks as before. Without
 * JavaScript it simply stays stuck to the top.
 */
import { Image } from 'astro:assets';
import { mainNav, signupLink, site } from '../config/site';
import { ariaCurrentFor } from '../lib/url';

const currentPath = Astro.url.pathname;
const signupCurrent = ariaCurrentFor(currentPath, signupLink.href);
const focusRing =
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
// Hover shows a red underline; the current page keeps a white one.
const linkClass = `rounded px-1 py-1 font-medium whitespace-nowrap text-white/85 decoration-2 underline-offset-8 hover:text-white hover:underline hover:decoration-brand-red-bright [&[aria-current]]:text-white [&[aria-current]]:underline [&[aria-current]]:decoration-white ${focusRing}`;
// 44 px tall like the Menu button. forced-colors:border-2 keeps the button shape in Windows
// contrast themes (no change otherwise). The display (inline-flex / flex) is set where used.
const ctaClass = `h-11 items-center rounded-md bg-brand-red px-4 font-semibold whitespace-nowrap text-white hover:bg-brand-red-dark forced-colors:border-2 ${focusRing}`;
const mobileLinkClass = `block rounded px-3 py-2.5 font-medium text-white/85 hover:bg-white/10 hover:text-white [&[aria-current]]:text-white [&[aria-current]]:underline [&[aria-current]]:underline-offset-8 ${focusRing}`;
---

{/* data-hidden: slid out of view (scrolling down); data-scrolled: not at the top of the page,
    so a shadow separates it from the content below. Reduced motion: no slide, just hidden. */}
<header
  data-site-header
  class="sticky top-0 z-40 bg-ink text-white data-[hidden]:-translate-y-full data-[scrolled]:shadow-lg data-[scrolled]:shadow-black/30 data-[hidden]:shadow-none motion-safe:transition-[translate,box-shadow] motion-safe:duration-300 motion-safe:ease-out"
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3">
    <a href="/" class={`flex items-center gap-3 rounded ${focusRing}`}>
      {/* 72 px on phones from 360 px wide and tablets (22 px stay free next to Menu at 360 px),
          96 px on laptops. The narrowest phones (320 px) keep 48 px: a larger logo would push
          the Menu button onto a second row. */}
      <Image
        src={site.logo}
        alt=""
        width={192}
        height={192}
        loading="eager"
        class="size-12 rounded-full min-[22.5rem]:size-18 lg:size-24"
      />
      <span class="text-lg font-extrabold tracking-wider uppercase sm:text-xl sm:tracking-widest lg:text-2xl">
        {site.name}
      </span>
    </a>

    <nav aria-label="Menu główne" class="hidden lg:block">
      <ul class="flex items-center gap-6">
        {mainNav.map((link) => (
          <li>
            <a
              href={link.href}
              class={linkClass}
              aria-current={ariaCurrentFor(currentPath, link.href)}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href={signupLink.href} class={`inline-flex ${ctaClass}`} aria-current={signupCurrent}>
            {signupLink.label}
          </a>
        </li>
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-3 lg:hidden">
      <a
        href={signupLink.href}
        class={`hidden sm:inline-flex ${ctaClass}`}
        aria-current={signupCurrent}
      >
        {signupLink.label}
      </a>
      <details data-menu class="group relative">
        <summary
          class={`block h-11 list-none rounded-md border border-white/40 px-3 font-medium group-open:bg-white/10 hover:bg-white/10 [&::-webkit-details-marker]:hidden ${focusRing}`}
        >
          <span class="flex h-full items-center gap-2">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              class="size-5 group-open:hidden"
            >
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              class="hidden size-5 group-open:block"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
            Menu
          </span>
        </summary>
        <nav
          aria-label="Menu mobilne"
          class="absolute right-0 z-40 mt-2 w-64 max-w-[calc(100vw-2rem)] rounded-md border border-white/20 bg-ink p-2 shadow-lg"
        >
          <ul class="flex flex-col">
            {mainNav.map((link) => (
              <li>
                <a
                  href={link.href}
                  class={mobileLinkClass}
                  aria-current={ariaCurrentFor(currentPath, link.href)}
                >
                  {link.label}
                </a>
              </li>
            ))}
            <li class="p-1 pt-2 sm:hidden">
              <a
                href={signupLink.href}
                class={`flex justify-center ${ctaClass}`}
                aria-current={signupCurrent}
              >
                {signupLink.label}
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Progressive enhancement for the mobile menu (the <details> works without this script).
  const menu = document.querySelector<HTMLDetailsElement>('details[data-menu]');
  const summary = menu?.querySelector('summary');
  if (menu && summary) {
    const close = () => {
      menu.open = false;
    };
    // Escape closes the menu and returns focus to "Menu".
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        close();
        summary.focus();
      }
    });
    // A tap or click outside closes it (pointerdown also catches the start of a scroll).
    document.addEventListener('pointerdown', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) close();
    });
    // Tabbing out of the menu closes it, so it never covers the next focused element.
    menu.addEventListener('focusout', (event) => {
      const next = event.relatedTarget;
      if (menu.open && next instanceof Node && !menu.contains(next)) close();
    });
    // A page restored from the back/forward cache starts with the menu closed.
    addEventListener('pageshow', (event) => {
      if (event.persisted) close();
    });
  }

  // Hide on scroll down, show on scroll up. The header never hides near the top of the page,
  // while the mobile menu is open, or while it holds keyboard focus.
  const header = document.querySelector<HTMLElement>('header[data-site-header]');
  if (header) {
    // Distances count from the furthest point reached since the header last changed: the
    // lowest point while it is hidden, the highest while it is shown. A finger wobbling back a
    // few pixels during a swipe therefore changes nothing (a fixed 10 px step from the last
    // move made the header flicker on phones).
    const SHOW_AFTER = 30; // px scrolled up from the lowest point since it hid
    const HIDE_AFTER = 60; // px scrolled down from the highest point since it showed
    const HOLD_MS = 300; // a new state lasts at least as long as the slide (decisions wait)
    let hidden = false;
    let extremeY = scrollY;
    let holdUntil = 0;
    let scheduled = false;
    let recheck: ReturnType<typeof setTimeout> | undefined;
    const setHidden = (next: boolean) => {
      if (next === hidden) return;
      hidden = next;
      header.toggleAttribute('data-hidden', next);
      extremeY = scrollY;
      holdUntil = performance.now() + HOLD_MS;
    };
    const keepShown = () => Boolean(menu?.open) || header.querySelector(':focus-visible') !== null;
    const update = () => {
      scheduled = false;
      const y = scrollY;
      header.toggleAttribute('data-scrolled', y > 0);
      if (y <= header.offsetHeight) {
        setHidden(false);
        extremeY = y;
        return;
      }
      // The rubber-band bounce past the end of the page (iOS) is not a change of direction.
      if (y > document.documentElement.scrollHeight - innerHeight) return;
      extremeY = hidden ? Math.max(extremeY, y) : Math.min(extremeY, y);
      const wait = holdUntil - performance.now();
      if (wait > 0) {
        // Still sliding: decide once the slide is over, even if the scrolling has stopped.
        clearTimeout(recheck);
        recheck = setTimeout(requestUpdate, wait);
        return;
      }
      if (hidden && y <= extremeY - SHOW_AFTER) setHidden(false);
      else if (!hidden && y >= extremeY + HIDE_AFTER && !keepShown()) setHidden(true);
    };
    const requestUpdate = () => {
      if (!scheduled) {
        scheduled = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener('scroll', requestUpdate, { passive: true });
    // Keyboard users reaching the header (Shift+Tab, skip back) always see it, at once.
    header.addEventListener('focusin', () => setHidden(false));
    menu?.addEventListener('toggle', () => {
      if (menu.open) setHidden(false);
    });
    // Coming back to the page (back/forward cache) shows the header again.
    addEventListener('pageshow', () => {
      setHidden(false);
      extremeY = scrollY;
    });
    // In-page links and focused form fields stop below the header: the layout sets
    // scroll-padding-top from this height (WCAG 2.4.11, focus not hidden).
    const setHeight = () =>
      document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
    new ResizeObserver(setHeight).observe(header);
    update();
  }
</script>
